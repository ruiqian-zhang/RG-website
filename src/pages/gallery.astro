---
import { withBase } from '../lib/urls';
import BaseLayout from '../layouts/BaseLayout.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import OrangeFeature from '../components/OrangeFeature.astro';
import gallery from '../content/gallery.json';
---
<BaseLayout title="Gallery | RoboGrinder at Virginia Tech" description="Competition and season photos from RoboGrinder at Virginia Tech.">
  <a class="skip-link" href="#main">Skip to content</a>
  <SiteHeader active="Gallery" />
  <main id="main">
    <OrangeFeature title="Life on the grind." description="The builds, the competitions, and the moments we share along the way." image="/images/rmul-2025-fleet.webp" imageAlt="RoboGrinder's three competition robots in the arena">
      <a class="button button-swipe button-dark" href="#seasons">Explore the photos<span class="material-icon" aria-hidden="true">chevron_right</span></a>
    </OrangeFeature>
    <div class="seasons" id="seasons">
      {gallery.seasons.map((season) => <details class="season" data-disclosure>
        <summary><h2>{season.title}</h2><span class="material-icon season-arrow" aria-hidden="true">expand_more</span></summary>
        <div class="disclosure-panel">
        <p class="season-description">{season.description}</p>
        <div class="photo-grid">{season.photos.map((photo) => <figure>
          <button class="photo-preview" type="button" data-image={withBase(photo.image)} data-caption={photo.caption} aria-label={`View photo: ${photo.caption}`} aria-haspopup="dialog"><img src={withBase(photo.image)} alt={photo.caption} loading="lazy" width="1600" height="1067" /></button>
          <figcaption>{photo.caption}</figcaption>
        </figure>)}</div>
        </div>
      </details>)}
    </div>
    <dialog class="photo-lightbox" aria-label="Photo preview" aria-describedby="preview-caption">
      <button class="preview-close button button-swipe" type="button" aria-label="Close photo preview" autofocus><span class="material-icon" aria-hidden="true">close</span></button>
      <figure><img class="preview-image" alt="" loading="lazy" draggable="true" data-allow-image-save /><figcaption id="preview-caption"></figcaption></figure>
    </dialog>
  </main>
  <SiteFooter />
<script>
  const dialog = document.querySelector<HTMLDialogElement>('.photo-lightbox');
  const image = dialog?.querySelector<HTMLImageElement>('.preview-image');
  const caption = dialog?.querySelector<HTMLElement>('figcaption');
  let opener: HTMLButtonElement | null = null;
  let previousOverflow = '';
  document.querySelectorAll<HTMLButtonElement>('.photo-preview').forEach((button) => {
    button.addEventListener('click', () => {
      if (!dialog || !image || !caption || !button.dataset.image) return;
      opener = button;
      image.src = button.dataset.image;
      image.alt = button.dataset.caption || '';
      caption.textContent = image.alt;
      previousOverflow = document.body.style.overflow;
      document.body.style.overflow = 'hidden';
      dialog.showModal();
    });
  });
  dialog?.querySelector('.preview-close')?.addEventListener('click', () => dialog.close());
  dialog?.addEventListener('click', (event) => {
    const bounds = dialog.getBoundingClientRect();
    if (event.target === dialog && (event.clientX < bounds.left || event.clientX > bounds.right || event.clientY < bounds.top || event.clientY > bounds.bottom)) dialog.close();
  });
  dialog?.addEventListener('close', () => {
    document.body.style.overflow = previousOverflow;
    opener?.focus({ preventScroll: true });
  });
</script>
</BaseLayout>
<style>
  .seasons { padding: 64px clamp(24px, 8vw, 124px) 80px; scroll-margin-top: var(--scroll-header-offset); }
  .season { border-bottom: 1px solid var(--line); }
  summary { display: flex; align-items: center; justify-content: space-between; gap: 24px; min-height: 80px; padding: 24px 0; }
  h2 { margin: 0; font: 700 clamp(24px, 3vw, 36px)/1.2 var(--display); letter-spacing: -.03em; }
  .season-arrow { flex-shrink: 0; transition: rotate 300ms ease; }
  summary[aria-expanded="true"] > .season-arrow { rotate: 180deg; }
  summary:focus-visible { outline: 3px solid var(--orange); outline-offset: 4px; }
  .disclosure-panel { padding-bottom: 36px; }
  .season-description { margin: 0 0 36px; font-size: var(--font-body-min); line-height: 1.6; }
  .photo-grid { display: grid; grid-template-columns: repeat(3, minmax(0,1fr)); gap: 36px 28px; }
  figure { margin: 0; }
  .photo-preview { display: block; width: 100%; padding: 0; border: 0; background: transparent; cursor: zoom-in; }
  .photo-preview:focus-visible { outline: 3px solid var(--orange); outline-offset: 4px; }
  .photo-grid img { display: block; width: 100%; height: auto; aspect-ratio: 3 / 2; object-fit: cover; clip-path: polygon(0 0, 100% 0, 100% calc(100% - 18px), calc(100% - 18px) 100%, 0 100%); }
  .photo-lightbox { width: min(1100px, calc(100vw - 48px)); max-width: none; max-height: calc(100dvh - 48px); padding: 24px; border: 1px solid rgba(255,255,255,.2); background: var(--ink); color: var(--paper); }
  .photo-lightbox::backdrop { background: rgba(0,0,0,.88); }
  .preview-close { display: grid; place-items: center; width: 48px; height: 48px; min-height: 48px; padding: 0; margin: 0 0 16px auto; border: 0; background: var(--orange); color: #fff; --hover-fill: #fff; --hover-ink: var(--ink); cursor: pointer; }
  .preview-image { display: block; width: 100%; height: auto; max-height: calc(100dvh - 200px); object-fit: contain; }
  figcaption { margin-top: 14px; font-size: var(--font-label-min); line-height: 1.5; }
  @media (max-width: 950px) { .photo-grid { grid-template-columns: repeat(2,minmax(0,1fr)); } }
  @media (max-width: 520px) { .seasons { padding: 32px 23px 56px; } summary { gap: 16px; min-height: 72px; padding: 20px 0; } .photo-grid { grid-template-columns: 1fr; gap: 28px; } .photo-lightbox { width: calc(100vw - 24px); padding: 16px; } }
</style>
