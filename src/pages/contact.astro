---
import BaseLayout from '../layouts/BaseLayout.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import OrangeFeature from '../components/OrangeFeature.astro';
import ContactForm from '../components/ContactForm.astro';
import site from '../content/site.json';
---

<BaseLayout title="Contact | RoboGrinder at Virginia Tech" description="Send a message to RoboGrinder at Virginia Tech about joining, sponsorship, or collaboration.">
  <a class="skip-link" href="#main">Skip to content</a>
  <SiteHeader active="Contact" />
  <main id="main">
    <OrangeFeature title="Contact us" description="Have a question, a project idea, or a partnership in mind? We’d love to hear from you." image="/images/rmul-2025-interview.webp" imageAlt="RoboGrinder members sharing their team's story during an interview">
      <a class="button button-swipe button-dark" href="#message">Send a message<span class="material-icon" aria-hidden="true">chevron_right</span></a>
    </OrangeFeature>
    <section class="contact-page" id="message" aria-labelledby="message-title">
      <div class="contact-intro">
        <h2 id="message-title">Let’s talk.</h2>
        <p>Tell us what’s on your mind. Choose a topic so your message reaches the right people.</p>
        {site.contactEmail && <a class="button button-swipe button-dark direct-email" href={`mailto:${site.contactEmail}`}>Email the team<span class="material-icon" aria-hidden="true">chevron_right</span></a>}
      </div>
      <ContactForm />
    </section>
  </main>
  <SiteFooter />
</BaseLayout>



<style>
  .contact-page { display: grid; grid-template-columns: .9fr 1.1fr; gap: clamp(40px, 8vw, 120px); padding: 80px clamp(24px, 8vw, 124px); background: var(--paper); scroll-margin-top: var(--scroll-header-offset); }
  h1, h2 { font-family: var(--display); }
  .contact-intro h2 { max-width: 560px; margin: 0 0 24px; font-size: clamp(36px, 4.5vw, 58px); line-height: 1.05; letter-spacing: -.035em; }
  .contact-intro > p { max-width: 430px; margin: 0; color: var(--ink); font-size: var(--font-body-min); line-height: 1.65; }
  .direct-email { margin-top: 28px; }
  .button { min-height: 52px; display: inline-flex; align-items: center; justify-content: center; gap: 10px; padding: 0 17px; border: 0; font: 700 var(--font-ui-min) var(--body); cursor: pointer; }
  .button-dark { background: var(--ink); color: var(--paper); }
  .material-icon { font-size: 20px; }
  @media (max-width: 820px) { .contact-page { grid-template-columns: 1fr; gap: 40px; padding-top: 72px; padding-bottom: 76px; } }
  @media (max-width: 560px) { .contact-page { padding: 56px 23px; } }
</style>
