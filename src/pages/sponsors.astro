---
import BaseLayout from '../layouts/BaseLayout.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import SponsorLogos from '../components/SponsorLogos.astro';
import OrangeFeature from '../components/OrangeFeature.astro';
import ContactForm from '../components/ContactForm.astro';
import sponsorship from '../content/sponsors.json';
import site from '../content/site.json';
import members from '../content/members.json';
import subteams from '../content/subteams.json';
const memberCount = new Set(members.people.map((person) => person.name.trim().toLowerCase())).size;
---
<BaseLayout title="Partnerships | RoboGrinder at Virginia Tech" description="Partner with Virginia Tech's student-led RoboGrinder team. Connect with emerging engineering talent, share expertise, and help students build practical experience.">
  <a class="skip-link" href="#main">Skip to content</a>
  <SiteHeader active="Sponsors" />
  <main id="main">
    <OrangeFeature title={sponsorship.headline} description={sponsorship.intro} image={sponsorship.image} imageAlt={sponsorship.imageAlt}>
      <div class="hero-actions">
        <a class="button button-swipe button-dark" href="#connect">Start a conversation<span class="material-icon" aria-hidden="true">chevron_right</span></a>
        <a class="button button-swipe button-dark packet-link" href={sponsorship.packetUrl} target="_blank" rel="noreferrer">View sponsorship packet<span class="material-icon" aria-hidden="true">open_in_new</span></a>
      </div>
    </OrangeFeature>
    <section class="who section-shell" aria-labelledby="who-title">
      <div><h2 id="who-title">Student led.<br />Industry focused.</h2><p>We’re a student-led engineering team at Virginia Tech, bringing students together since 2016. Members take ideas through design, build, and testing, learning to deliver as a team.</p></div>
      <dl class="team-facts"><div><dt>Current members</dt><dd>{memberCount}</dd></div><div><dt>Subteams working together</dt><dd>{subteams.teams.length}</dd></div><div><dt>2025 RMUL North America · 3v3</dt><dd>1st</dd></div></dl>
    </section>
    <section class="benefits section-shell" aria-labelledby="benefits-title">
      <header><h2 id="benefits-title">What your company gains.</h2></header>
      <div class="benefit-list">{sponsorship.benefits.map((benefit, i) => <article><span class="benefit-number" aria-hidden="true">0{i + 1}</span><h3>{benefit.title}</h3><p>{benefit.description}</p></article>)}</div>
    </section>
    <section class="support section-shell" aria-labelledby="support-title">
      <div><h2 id="support-title">Help turn ideas into experience.</h2><p>Choose the contribution that fits your company. Funding, equipment, and expertise all help students learn through a full engineering cycle.</p></div>
      <div class="support-list">{sponsorship.supportOptions.map((option) => <article><h3>{option.title}</h3><p>{option.description}</p></article>)}</div>
    </section>
    <section class="partners section-shell" aria-labelledby="partners-title"><h2 id="partners-title">Our sponsors</h2><SponsorLogos partners={sponsorship.partners} /></section>
    <section class="connect section-shell" id="connect" aria-labelledby="connect-title">
      <div><h2 id="connect-title">Interested in partnering with us?</h2><p>Tell us about your company, your goals, and how you’d like to get involved. We’ll discuss a partnership that works for both of us.</p><a class="button button-swipe button-light packet-link connect-packet" href={sponsorship.packetUrl} target="_blank" rel="noreferrer">View sponsorship packet<span class="material-icon" aria-hidden="true">open_in_new</span></a></div>
      <ContactForm partnership />
    </section>
  </main>
  <SiteFooter />
</BaseLayout>
<style>
  .section-shell { padding: 80px clamp(24px, 8vw, 124px); }
  h2 { margin: 0 0 24px; font: 700 clamp(36px, 4.5vw, 58px)/1.05 var(--display); letter-spacing: -.035em; text-wrap: balance; }
  h3 { margin: 0; font: 700 clamp(23px, 2.2vw, 28px)/1.15 var(--display); text-wrap: balance; }
  p { margin: 0; font-size: var(--font-body-min); line-height: 1.65; }
  .eyebrow { margin-bottom: 20px; font-size: var(--font-label-min); font-weight: 700; letter-spacing: .08em; text-transform: uppercase; }
  .hero-actions { display: flex; flex-wrap: wrap; align-items: center; gap: 16px 24px; }
  .packet-link { display: inline-flex; min-height: 48px; align-items: center; gap: 10px; font-size: var(--font-ui-min); font-weight: 600; text-decoration: none; }
  .who { display: grid; grid-template-columns: 1fr 1fr; gap: 72px; align-items: center; }
  .who p { max-width: 520px; }
  .team-facts { margin: 0; display: grid; gap: 24px; }
  .team-facts > div { display: flex; flex-direction: row-reverse; align-items: center; justify-content: flex-end; gap: 28px; }
  dt { font-size: var(--font-body-min); line-height: 1.5; }
  dd { margin: 0; min-width: 100px; font: 700 64px/1 var(--display); font-variant-numeric: tabular-nums; }
  .benefits { padding-top: 0; }
  .benefits header { max-width: 780px; margin-bottom: 40px; }
  .benefit-list article { display: grid; grid-template-columns: 48px 1fr 1.3fr; gap: 32px; padding: 32px 0; border-top: 1px solid rgba(0,0,0,.25); }
  .benefit-number { font: 700 24px/1.2 var(--display); }
  .benefit-list p { max-width: 620px; }
  .support { display: grid; grid-template-columns: 1fr 1fr; gap: 72px; background: var(--orange); color: var(--ink); }
  .support > div > p:last-child { max-width: 470px; }
  .support-list article { border-top: 1px solid rgba(0,0,0,.3); padding: 24px 0; }
  .support-list article:last-child { padding-bottom: 0; }
  .support-list h3 { margin-bottom: 12px; }
  .partners h2 { margin-bottom: 64px; text-align: center; }
  .connect { display: grid; grid-template-columns: 1fr 1fr; gap: 64px; align-items: start; background: var(--ink); color: var(--paper); scroll-margin-top: var(--header-height); }
  .connect p { max-width: 560px; }
  .connect-packet { margin-top: 28px; }
  .button-light { background: var(--paper); color: var(--ink); --hover-fill: var(--orange); --hover-ink: var(--paper); }
  .connect :focus-visible { outline-color: var(--orange); }
  @media (max-width: 1000px) { .who, .support, .connect { gap: 40px; } .benefit-list article { grid-template-columns: 36px 1fr 1.2fr; gap: 24px; } }
  @media (max-width: 800px) {
    .who, .support, .connect { grid-template-columns: 1fr; }
    .team-facts { grid-template-columns: repeat(3, minmax(0,1fr)); }
    .team-facts > div { flex-direction: column-reverse; align-items: flex-start; gap: 12px; }
    .benefit-list article { grid-template-columns: 36px 1fr; gap: 16px 24px; }
    .benefit-list p { grid-column: 2; }
  }
  @media (max-width: 540px) {
    .section-shell { padding: 56px 23px; } .benefits { padding-top: 0; }
    .team-facts { gap: 16px; } dd { min-width: 0; font-size: 48px; } dt { font-size: 16px; }
    .benefit-list article { grid-template-columns: 28px 1fr; gap: 12px 16px; padding: 28px 0; }
    .partners h2 { margin-bottom: 44px; }
  }
  @media (max-width: 420px) {
    .team-facts { grid-template-columns: 1fr; gap: 24px; }
    .team-facts > div { flex-direction: row-reverse; align-items: center; gap: 24px; }
    dd { min-width: 80px; }
  }
</style>
