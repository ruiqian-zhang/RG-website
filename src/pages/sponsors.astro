---
import BaseLayout from '../layouts/BaseLayout.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import OurSponsors from '../components/OurSponsors.astro';
import OrangeFeature from '../components/OrangeFeature.astro';
import ContactForm from '../components/ContactForm.astro';
import sponsorship from '../content/sponsors.json';
import site from '../content/site.json';
import members from '../content/members.json';
import subteams from '../content/subteams.json';
const memberCount = new Set(members.people.map((person) => person.name.trim().toLowerCase())).size;
---
<BaseLayout title="Partnerships | RoboGrinder at Virginia Tech" description="Partner with Virginia Tech's student-led RoboGrinder team. Connect with emerging engineering talent, share expertise, and help students build practical experience.">
  <a class="skip-link" href="#main">Skip to content</a>
  <SiteHeader active="Sponsors" />
  <main id="main" class="sponsor-page">
    <OrangeFeature title={sponsorship.headline} description={sponsorship.intro} image={sponsorship.image} imageAlt={sponsorship.imageAlt}>
      <div class="hero-actions">
        <a class="button button-swipe button-dark" href="#connect">Start a conversation<span class="material-icon" aria-hidden="true">chevron_right</span></a>
        <a class="button button-swipe button-dark packet-link" href={sponsorship.packetUrl} target="_blank" rel="noreferrer">View sponsorship packet<span class="material-icon" aria-hidden="true">open_in_new</span></a>
      </div>
    </OrangeFeature>
    <section class="who section-shell" aria-labelledby="who-title">
      <div><h2 id="who-title">Student led.<br />Industry focused.</h2><p>We’re a student-led engineering team at Virginia Tech, bringing students together since 2016. Members take ideas through design, build, and testing, learning to deliver as a team.</p></div>
      <dl class="team-facts"><div><dt>Current members</dt><dd>{memberCount}</dd></div><div><dt>Shared mission</dt><dd>1</dd></div><div><dt>Subteams working together</dt><dd>{subteams.teams.length}</dd></div><div><dt>Most consistent ARC teams</dt><dd>Top 4</dd></div></dl>
    </section>
    <section class="benefits section-shell" aria-labelledby="benefits-title">
      <header><h2 id="benefits-title">What sponsors get</h2><p>These benefits are available at eligible company donation tiers. Resume drops, events, and recognition depend on your sponsorship level. See the <a href={sponsorship.packetUrl} target="_blank" rel="noreferrer">sponsorship packet</a> for tier details.</p></header>
      <div class="benefit-list">{sponsorship.benefits.map((benefit) => <article><span class="benefit-icon material-icon" aria-hidden="true">{benefit.icon}</span><div><h3>{benefit.title}</h3><p>{benefit.description}</p></div></article>)}</div>
    </section>
    <section class="support section-shell" aria-labelledby="support-title">
      <div><h2 id="support-title">Help the team build and compete.</h2><p>From business sponsorships to support from family and friends, every contribution helps. Funding, equipment, and expertise cover the work in our lab and the costs of getting to competitions.</p></div>
      <div class="support-list">{sponsorship.supportOptions.map((option) => <article><h3>{option.title}</h3><p>{option.description}</p></article>)}</div>
    </section>
    <OurSponsors partners={sponsorship.partners} id="partners" />
    <section class="connect section-shell" id="connect" aria-labelledby="connect-title">
      <div><h2 id="connect-title">Interested in supporting us?</h2><p>Tell us how you’d like to help. Whether you represent a business or want to contribute personally, we’d like to hear from you.</p><a class="button button-swipe button-light packet-link connect-packet" href={sponsorship.packetUrl} target="_blank" rel="noreferrer">View sponsorship packet<span class="material-icon" aria-hidden="true">open_in_new</span></a></div>
      <ContactForm partnership />
    </section>
  </main>
  <SiteFooter />
</BaseLayout>
<style>
  .benefits { display: flex; flex-direction: column; justify-content: center; }
  .section-shell { padding: 80px clamp(24px, 8vw, 124px); }
  h2 { margin: 0 0 24px; font: 700 clamp(36px, 4.5vw, 58px)/1.05 var(--display); letter-spacing: -.035em; text-wrap: balance; }
  h3 { margin: 0; font: 700 clamp(23px, 2.2vw, 28px)/1.15 var(--display); text-wrap: balance; }
  p { margin: 0; font-size: var(--font-body-min); line-height: 1.65; }
  .eyebrow { margin-bottom: 20px; font-size: var(--font-label-min); font-weight: 700; letter-spacing: .08em; text-transform: uppercase; }
  .hero-actions { display: flex; flex-wrap: wrap; align-items: center; gap: 16px 24px; }
  .packet-link { display: inline-flex; min-height: 48px; align-items: center; gap: 10px; font-size: var(--font-ui-min); font-weight: 600; text-decoration: none; }
  .who { display: grid; grid-template-columns: 1fr 1fr; gap: 72px; align-items: center; align-content: center; }
  .who p { max-width: 520px; }
  .team-facts { margin: 0; display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 40px 32px; }
  .team-facts > div { display: flex; flex-direction: column-reverse; align-items: flex-start; justify-content: flex-end; gap: 16px; }
  dt { font-size: var(--font-body-min); line-height: 1.5; }
  dd { margin: 0; white-space: nowrap; font: 700 clamp(44px, 4.8vw, 64px)/1 var(--display); font-variant-numeric: tabular-nums; }
  .benefits { background: var(--ink); color: var(--paper); }
  .benefits header { margin-bottom: 32px; }
  .benefits header p { max-width: 760px; }
  .benefits header a { text-underline-offset: 4px; }
  .benefit-list { display: grid; grid-template-columns: repeat(2, minmax(0,1fr)); column-gap: 48px; }
  .benefit-list article { display: grid; grid-template-columns: 44px minmax(0,1fr); gap: 18px; padding: 28px 0; border-bottom: 1px solid rgba(240,240,240,.2); }
  .benefit-icon { display: grid; place-items: center; width: 40px; height: 32px; color: var(--orange); font-size: 28px; }
  .benefit-list h3 { margin-bottom: 10px; font-size: clamp(22px, 2vw, 26px); }
  .benefit-list p { max-width: 620px; }
  .support { display: grid; grid-template-columns: 1fr 1fr; align-items: center; gap: 72px; background: var(--orange); color: var(--ink); }
  .support > div > p:last-child { max-width: 470px; }
  .support-list article { padding: 24px 0; }
  .support-list article + article { border-top: 1px solid rgba(0,0,0,.3); }
  .support-list article:first-child { border-top: 0; padding-top: 0; }
  .support-list article:last-child { padding-bottom: 0; }
  .support-list h3 { margin-bottom: 12px; }
  .connect { display: grid; grid-template-columns: 1fr 1fr; gap: 64px; align-items: start; background: var(--ink); color: var(--paper); scroll-margin-top: var(--header-height); }
  .connect p { max-width: 560px; }
  .connect-packet { margin-top: 28px; }
  .button-light { background: var(--paper); color: var(--ink); --hover-fill: var(--orange); --hover-ink: var(--paper); }
  .connect :focus-visible { outline-color: var(--orange); }
  @media (max-width: 1000px) { .who, .support, .connect { gap: 40px; } .benefit-list { column-gap: 28px; } }
  @media (max-width: 800px) {
    .who, .support, .connect { grid-template-columns: 1fr; }
    .team-facts { max-width: 560px; }
    dd { font-size: clamp(44px, 8vw, 64px); }
    .benefit-list { grid-template-columns: 1fr; }
  }
  @media (max-width: 540px) {
    .section-shell { padding: 56px 23px; }
    .team-facts { gap: 32px 24px; } dd { font-size: clamp(42px, 13vw, 48px); } dt { font-size: 16px; }
    .benefit-list article { gap: 12px; }
  }
  @media (max-width: 680px) { .sponsor-page > :global(.orange-feature) { min-height: 0; } }
</style>
