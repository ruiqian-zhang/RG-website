---
const { title = 'RoboGrinder | Virginia Tech Robotics', description = 'Student-built competitive robotics at Virginia Tech. Founded in 2016.' } = Astro.props;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#f0f0f0" />
    <meta name="description" content={description} />
    <link rel="icon" type="image/png" href="/images/rg-black.png" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin="anonymous" />
    <link href="https://fonts.googleapis.com/css2?family=Chakra+Petch:wght@600;700&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet" />
    <link href="https://fonts.googleapis.com/icon?family=Material+Icons+Round" rel="stylesheet" />
    <title>{title}</title>
    <slot name="head" />
  </head>
  <body>
    <slot />
  </body>
</html>

<style is:global>
  :root {
    color-scheme: light;
    --header-height: 76px;
    --orange: #ed721e;
    --ink: #000000;
    --paper: #f0f0f0;
    --muted-ink: rgba(0,0,0,.68);
    --line: rgba(0, 0, 0, 0.2);
    --font-body-min: 16px;
    --font-ui-min: 15px;
    --font-label-min: 13px;
    --display: 'Chakra Petch', sans-serif;
    --body: 'Inter', sans-serif;
    font-family: var(--body);
    color: var(--ink);
    background: var(--paper);
    font-synthesis: none;
    text-rendering: optimizeLegibility;
    scroll-behavior: smooth;
  }
  *, *::before, *::after { box-sizing: border-box; }
  body { margin: 0; min-width: 0; font-size: var(--font-body-min); }
  a { color: inherit; }
  h1, h2, h3 { text-wrap: balance; }
  section[id], h2[id] { scroll-margin-top: var(--header-height); }
  .skip-link { position: fixed; z-index: 40; top: 8px; left: 8px; padding: 12px 16px; transform: translateY(-150%); background: var(--paper); color: var(--ink); }
  .skip-link:focus { transform: translateY(0); }
  img { display: block; max-width: 100%; }
  button, a { -webkit-tap-highlight-color: transparent; }
  :is(.button, .header-cta) {
    --button-cut: 10px;
    clip-path: polygon(var(--button-cut) 0, 100% 0, 100% calc(100% - var(--button-cut)), calc(100% - var(--button-cut)) 100%, 0 100%, 0 var(--button-cut));
  }
  /* Dropdown controls retain their colors; regular buttons use only a swipe fill. */
  .button-swipe { --hover-fill: var(--paper); --hover-ink: var(--ink); position: relative; isolation: isolate; overflow: hidden; transition: color 250ms ease; }
  .button-swipe::before { position: absolute; inset: 0; z-index: -1; content: ''; background: var(--hover-fill); transform: scaleX(0); transform-origin: left; transition: transform 250ms ease; }
  .button { display: inline-flex; min-height: 52px; align-items: center; justify-content: center; gap: 12px; padding: 0 18px; border: 0; font: 700 var(--font-ui-min) var(--body); text-decoration: none; cursor: pointer; }
  .button-dark { background: var(--ink); color: var(--paper); --hover-fill: var(--orange); --hover-ink: var(--paper); }
  .orange-feature .button-dark { --hover-fill: var(--paper); --hover-ink: var(--ink); }
  .button-light { --hover-fill: var(--ink); --hover-ink: var(--paper); }
  .subteams-actions .button-dark { --hover-fill: var(--paper); --hover-ink: var(--ink); }
  .landing .button-light { --hover-fill: var(--orange); --hover-ink: var(--paper); }
  .join .button-dark, .header-cta, .contact-form .button-dark { --hover-fill: var(--paper); --hover-ink: var(--ink); }
  .button-accent { --hover-fill: var(--ink); --hover-ink: var(--paper); }
  @media (hover: hover) and (pointer: fine) {
    .button-swipe:not(:disabled):hover { color: var(--hover-ink); }
    .button-swipe:not(:disabled):hover::before { transform: scaleX(1); }
    .member-links .icon-button:hover { color: var(--orange); }
  }
  .icon-button { display: inline-flex; align-items: center; justify-content: center; width: 44px; height: 44px; padding: 0; border: 0; background: transparent; color: inherit; text-decoration: none; cursor: pointer; }
  .icon-button:disabled { cursor: default; opacity: .65; }
  .member-links .icon-button { --hover-fill: var(--ink); --hover-ink: var(--paper); }
  [data-disclosure] > summary { cursor: pointer; list-style: none; }
  [data-disclosure] > summary::-webkit-details-marker { display: none; }
  .disclosure-panel { overflow: hidden; }
  ::selection { color: var(--paper); background: var(--ink); }
  :focus-visible { outline: 3px solid var(--ink); outline-offset: 4px; }
  :is(.button, .header-cta, .icon-button):focus-visible { outline-offset: -4px; }
  .button-dark:focus-visible { outline-color: var(--paper); }
  .header-shell :focus-visible, .site-footer :focus-visible { outline-color: var(--orange); }
  .material-icon { font-family: 'Material Icons Round'; font-weight: normal; font-style: normal; font-size: 22px; line-height: 1; letter-spacing: normal; text-transform: none; display: inline-block; white-space: nowrap; word-wrap: normal; direction: ltr; -webkit-font-feature-settings: 'liga'; -webkit-font-smoothing: antialiased; }
  @media (max-width: 850px) { :root { --header-height: 70px; } }
  @media (max-width: 680px) {
    :root { --font-body-min: 16px; --font-ui-min: 15px; --font-label-min: 14px; }
  }
  @media (prefers-reduced-motion: reduce) {
    *, *::before, *::after { scroll-behavior: auto !important; animation-duration: .01ms !important; animation-iteration-count: 1 !important; transition-duration: .01ms !important; }
    .marquee-track { animation-duration: var(--marquee-duration) !important; animation-iteration-count: infinite !important; }
    .industry:not(.marquees-playing) .marquee-track { animation-play-state: paused !important; }
  }
</style>
