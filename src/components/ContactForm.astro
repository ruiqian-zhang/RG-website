---
import site from '../content/site.json';
const { partnership = false } = Astro.props;
---
<form class:list={['contact-form', partnership && 'partnership-form']} id="contact-form" data-contact-email={site.contactEmail || ''} data-sponsor-email={site.sponsorEmail || ''}>
  <div class="form-row">
    <label for="contact-name">Your name</label>
    <input id="contact-name" name="name" type="text" autocomplete="name" required />
  </div>
  <div class="form-row">
    <label for="contact-email">Email address</label>
    <input id="contact-email" name="email" type="email" autocomplete="email" required />
  </div>
  {partnership && <div class="form-row">
    <label for="contact-company">Business or organization (optional)</label>
    <input id="contact-company" name="company" type="text" autocomplete="organization" />
  </div>}
  <div class="form-row">
    <label for="contact-topic">What can we help with?</label>
    <select id="contact-topic" name="topic" required>
      <option value="" selected={!partnership} disabled>Select a topic</option>
      <option>Joining RoboGrinder</option>
      <option selected={partnership}>Sponsorship &amp; partnerships</option>
      <option>Collaboration</option>
      <option>Something else</option>
    </select>
  </div>
  <div class="form-row">
    <label for="contact-message">Your message</label>
    <textarea id="contact-message" name="message" rows="6" required></textarea>
  </div>
  <button class:list={['button', 'button-swipe', partnership ? 'button-light' : 'button-dark']} type="submit">Send message<span class="material-icon" aria-hidden="true">chevron_right</span></button>
  <p class="form-status" role="status" aria-live="polite">Your email app will open with the message ready to send.</p>
</form>
<script>
  document.querySelectorAll<HTMLFormElement>('.contact-form').forEach((form) => {
    form.addEventListener('submit', (event) => {
      event.preventDefault();
      const data = new FormData(form);
      const inbox = ((data.get('topic') === 'Sponsorship & partnerships' ? form.dataset.sponsorEmail : form.dataset.contactEmail) || form.dataset.contactEmail)?.trim();
      if (!inbox) {
        const status = form.querySelector<HTMLElement>('.form-status');
        if (status) status.textContent = 'The team inbox is not configured yet. Please check back soon.';
        return;
      }
      const subject = encodeURIComponent(`RoboGrinder inquiry: ${data.get('topic')}`);
      const company = data.get('company') ? `Organization: ${data.get('company')}\n` : '';
      const body = encodeURIComponent(`Name: ${data.get('name')}\nReply to: ${data.get('email')}\n${company}Topic: ${data.get('topic')}\n\n${data.get('message')}`);
      window.location.href = `mailto:${inbox}?subject=${subject}&body=${body}`;
    });
  });
</script>
<style>
  .contact-form { min-width: 0; color: var(--ink); }
  .contact-form .button-dark { --hover-fill: var(--orange); --hover-ink: var(--paper); }
  .partnership-form { border-top: 0; padding-top: 0; color: var(--paper); }
  .partnership-form .button-light { background: var(--paper); color: var(--ink); --hover-fill: var(--orange); --hover-ink: var(--paper); }
  .form-row { display: grid; gap: 8px; margin-bottom: 18px; }
  label { font-size: var(--font-ui-min); font-weight: 700; }
  input, select, textarea { width: 100%; min-height: 50px; padding: 12px 14px; border: 1px solid rgba(0,0,0,.55); border-radius: 0; background: var(--paper); color: var(--ink); font: 400 var(--font-body-min)/1.4 var(--body); }
  textarea { min-height: 150px; resize: vertical; }
  .form-status { margin: 13px 0 0; font-size: var(--font-label-min); line-height: 1.5; }
</style>
