---
import logoFrames from '../content/placement-logo-frames.json';
import site from '../content/site.json';
const { companies, title, description } = Astro.props;
const uniqueCompanies = companies.filter((company, index, list) => list.findIndex((item) => item.slug === company.slug) === index);
const sortedCompanies = [...uniqueCompanies].sort((a, b) => a.name.localeCompare(b.name, 'en'));
const rowSize = Math.floor(sortedCompanies.length / 3);
const remainder = sortedCompanies.length % 3;
const rows = Array.from({ length: 3 }, (_, index) => {
  const start = index * rowSize + Math.min(index, remainder);
  return sortedCompanies.slice(start, start + rowSize + (index < remainder ? 1 : 0));
});
---

<section class="industry" aria-labelledby="industry-title">
  <svg class="logo-filter" width="0" height="0" aria-hidden="true" focusable="false">
    <defs>
      <filter id="placement-grayscale" color-interpolation-filters="sRGB">
        <feColorMatrix type="saturate" values="0" />
        <feComponentTransfer>
          <feFuncR type="table" tableValues="0.35 0.941176" />
          <feFuncG type="table" tableValues="0.35 0.941176" />
          <feFuncB type="table" tableValues="0.35 0.941176" />
        </feComponentTransfer>
      </filter>
    </defs>
  </svg>
  <div class="industry-copy">
    <h2 id="industry-title">{title}</h2>
    <p>{description}</p>
  </div>
  <div class="marquees" aria-label="Career, research, and graduate study destinations">
    {rows.map((row, index) => (
      <div class="marquee">
        <div class:list={['marquee-track', index === 1 && 'marquee-track-reverse']} style={`--marquee-duration: ${row.length * 40}s`}>
          {[false, true].map((duplicate) => (
            <ul class="marquee-list" aria-hidden={duplicate ? 'true' : undefined}>
              {Array.from({ length: 5 }, () => row).flat().map((company, logoIndex) => {
                  const frame = logoFrames[company.slug as keyof typeof logoFrames];
                  const label = !duplicate && logoIndex < row.length ? company.name : undefined;
                  return <li class="industry-logo" data-brand={company.slug} style={`--logo-ratio: ${frame?.ratio ?? 2.5}`}>
                    <svg viewBox={frame?.viewBox ?? '0 0 1000 400'} role={label ? 'img' : undefined} aria-label={label} aria-hidden={label ? undefined : 'true'}>
                      <image href={company.logo} width={frame?.width ?? 1000} height={frame?.height ?? 400} preserveAspectRatio="xMidYMid meet" />
                    </svg>
                  </li>;
              })}
            </ul>
          ))}
        </div>
      </div>
    ))}
  </div>
  <div class="industry-actions">
    <a class="button button-swipe button-dark" href={site.joinLink}>Join us<span class="material-icon" aria-hidden="true">chevron_right</span></a>
    <button class="button button-swipe button-dark marquee-toggle" type="button" aria-label="Pause logos" aria-pressed="false"><span class="material-icon" aria-hidden="true">pause</span></button>
  </div>
</section>

<script>
  const industry = document.querySelector<HTMLElement>('.industry');
  const toggle = industry?.querySelector<HTMLButtonElement>('.marquee-toggle');
  if (industry && toggle) {
    const reducedMotion = matchMedia('(prefers-reduced-motion: reduce)');
    const setPaused = (paused: boolean) => {
      industry.classList.toggle('marquees-paused', paused);
      industry.classList.toggle('marquees-playing', !paused);
      toggle.setAttribute('aria-label', paused ? 'Play logos' : 'Pause logos');
      toggle.setAttribute('aria-pressed', String(paused));
      toggle.querySelector('.material-icon')!.textContent = paused ? 'play_arrow' : 'pause';
    };
    setPaused(reducedMotion.matches);
    toggle.addEventListener('click', () => setPaused(!industry.classList.contains('marquees-paused')));
    reducedMotion.addEventListener('change', (event) => setPaused(event.matches));
  }
  document.querySelectorAll<SVGImageElement>('.industry-logo image').forEach((image) => {
    const removeUnavailableLogo = () => {
      const brand = image.closest<HTMLElement>('.industry-logo')?.dataset.brand;
      const row = image.closest('.marquee');
      row?.querySelectorAll<HTMLElement>('.industry-logo').forEach((logo) => {
        if (logo.dataset.brand === brand) logo.remove();
      });
    };
    image.addEventListener('error', removeUnavailableLogo, { once: true });
  });
</script>

<style>
  .industry { overflow: hidden; padding: 96px 0 64px; background: var(--paper); }
  .logo-filter { position: absolute; pointer-events: none; }
  .industry-copy { max-width: 860px; margin: 0 auto 48px; padding: 0 26px; text-align: center; }
  h2 { margin: 0 0 24px; font: 700 clamp(40px, 5vw, 64px)/1.08 var(--display); letter-spacing: -.035em; text-wrap: balance; }
  .industry-copy p { max-width: 740px; margin: 0 auto; color: var(--muted-ink); font-size: var(--font-body-min); line-height: 1.75; }
  .marquees { display: grid; gap: 24px; }
  .industry-actions { display: flex; justify-content: center; gap: 16px; margin-top: 40px; padding: 0 24px; }
  .marquee-toggle { width: 52px; padding: 0; }
  .marquee { position: relative; width: 100%; overflow: hidden; }
  .marquee::before, .marquee::after { position: absolute; z-index: 1; top: 0; bottom: 0; width: clamp(24px, 6vw, 90px); content: ''; pointer-events: none; }
  .marquee::before { left: 0; background: linear-gradient(90deg, var(--paper), transparent); }
  .marquee::after { right: 0; background: linear-gradient(270deg, var(--paper), transparent); }
  .marquee-track { display: flex; width: max-content; animation: logo-scroll var(--marquee-duration) linear infinite; }
  .marquee-track-reverse { animation-direction: reverse; }
  .marquees-paused .marquee-track { animation-play-state: paused; }
  .marquee-list { display: flex; flex: 0 0 auto; align-items: center; gap: 72px; margin: 0; padding: 20px 36px; list-style: none; }
  .industry-logo { flex: 0 0 auto; width: min(200px, calc(var(--logo-ratio) * 60px)); aspect-ratio: var(--logo-ratio); }
  .industry-logo svg { display: block; width: 100%; height: 100%; overflow: hidden; filter: url(#placement-grayscale); }
  @keyframes logo-scroll { from { transform: translateX(0); } to { transform: translateX(-50%); } }
  @media (max-width: 680px) {
    .industry { padding: 72px 0 48px; }
    .industry-copy { margin-bottom: 36px; padding: 0 22px; }
    h2 { font-size: clamp(36px, 10vw, 48px); }
    .industry-copy p { text-align: left; }
    .marquees { gap: 16px; }
    .marquee-list { gap: 48px; padding: 16px 24px; }
    .industry-logo { width: min(170px, calc(var(--logo-ratio) * 48px)); }
  }
</style>
