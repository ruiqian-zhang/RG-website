---
import achievements from '../content/achievements.json';
import AchievementTimeline from './AchievementTimeline.astro';
const records = [...achievements.records].sort((a, b) => Number(b.year) - Number(a.year));
---
<section class="achievements" id="achievements" aria-labelledby="achievements-title">
  <h2 id="achievements-title">{achievements.title}</h2>
  <AchievementTimeline records={records.slice(0, 4)} />
  <details class="earlier-results" data-disclosure>
    <summary>Earlier results <span class="material-icon" aria-hidden="true">expand_more</span></summary>
    <div class="disclosure-panel"><AchievementTimeline records={records.slice(4)} /></div>
  </details>
</section>
<style>
  .achievements { min-height: calc(100svh - var(--header-height)); display: flex; flex-direction: column; justify-content: center; padding: 80px clamp(24px, 8vw, 124px); background: var(--paper); scroll-margin-top: var(--header-height); }
  h2 { margin: 0 0 40px; font: 700 clamp(38px, 5vw, 64px)/1.05 var(--display); letter-spacing: -.045em; }
  .earlier-results { margin-top: 28px; border-top: 1px solid var(--line); }
  summary { display: flex; align-items: center; justify-content: space-between; min-height: 60px; font: 700 20px/1.2 var(--display); }
  summary .material-icon { transition: rotate 300ms ease; }
  summary[aria-expanded="true"] .material-icon { rotate: 180deg; }
  .disclosure-panel { padding-top: 16px; }
  @media (max-width: 520px) { .achievements { padding: 64px 23px; } }
</style>
