---
import frames from '../content/sponsor-artwork-frames.json';
const { partners } = Astro.props;
const paperChannels = Array.from({ length: 256 }, (_, value) => Math.min(value, 240) / 255).join(' ');
const groups = [
  { departmental: false, partners: partners.filter((partner) => partner.category !== 'departmental' && partner.logo) },
  { departmental: true, partners: partners.filter((partner) => partner.category === 'departmental' && partner.logo) },
];
---

<svg class="logo-color-definition" width="0" height="0" aria-hidden="true"><defs><filter id="auvsi-paper" color-interpolation-filters="sRGB"><feComponentTransfer><feFuncR type="discrete" tableValues={paperChannels} /><feFuncG type="discrete" tableValues={paperChannels} /><feFuncB type="discrete" tableValues={paperChannels} /></feComponentTransfer></filter></defs></svg>

{groups.filter((group) => group.partners.length).map((group) => <div class:list={['sponsor-group', group.departmental && 'departmental']}>
  {group.departmental && <h3>Departmental supporters</h3>}
  <div class="sponsor-logos">
  {group.partners.map((partner) => (
    <a class="sponsor-logo" href={partner.url || '/contact/'} target={partner.url ? '_blank' : undefined} rel={partner.url ? 'noreferrer' : undefined} aria-label={`Visit ${partner.name}`}>
      {frames[partner.logo] && partner.logo !== '/images/partners/sec.png' ? <svg viewBox={frames[partner.logo].viewBox} aria-hidden="true" style={`--sponsor-ratio: ${frames[partner.logo].ratio}`}><image href={partner.logo} width={frames[partner.logo].width} height={frames[partner.logo].height} preserveAspectRatio="xMidYMid meet" /></svg> : <img src={partner.logo} alt="" loading="lazy" />}
    </a>
  ))}
</div>
</div>)}

<style>
  .sponsor-logos { display: flex; flex-wrap: wrap; justify-content: center; align-items: center; gap: 28px 64px; width: 100%; }
  .sponsor-logo { display: grid; flex: 0 0 calc((100% - 128px) / 3); place-items: center; min-width: 0; min-height: 160px; text-decoration: none; transition: opacity .2s; }
  .sponsor-logo:hover { opacity: .75; }
  .sponsor-logo img { width: 100%; max-width: 340px; height: 140px; object-fit: contain; }
  .logo-color-definition { position: absolute; pointer-events: none; }
  img[src="/images/partners/auvsi.png"] { filter: url(#auvsi-paper); }
  .sponsor-logo svg { display: block; width: min(100%, 340px, calc(var(--sponsor-ratio) * 140px)); aspect-ratio: var(--sponsor-ratio); overflow: hidden; }
  .departmental { margin-top: 40px; padding-top: 32px; border-top: 1px solid rgba(0,0,0,.2); }
  .departmental h3 { margin: 0 0 28px; text-align: center; font: 700 24px/1.2 var(--display); }
  .departmental .sponsor-logos { max-width: 740px; margin-inline: auto; gap: 24px 40px; }
  .departmental .sponsor-logo { flex: 0 1 220px; min-height: 100px; }
  .departmental .sponsor-logo img { max-width: 220px; height: 80px; }
  .departmental .sponsor-logo svg { width: min(100%, 220px, calc(var(--sponsor-ratio) * 80px)); }
  @media (max-width: 680px) {
    .departmental .sponsor-logos { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 20px 24px; }
    .departmental .sponsor-logo { width: 100%; min-height: 90px; }
    .sponsor-logos { gap: 24px 32px; }
    .sponsor-logo { flex-basis: calc((100% - 32px) / 2); min-height: 120px; }
    .sponsor-logo img { height: 120px; }
    .sponsor-logo svg { width: min(100%, 340px, calc(var(--sponsor-ratio) * 120px)); }
  }
  @media (max-width: 420px) {
    .sponsor-logo { flex-basis: 100%; }
    .sponsor-logo img { max-width: 280px; height: 180px; }
    .sponsor-logo svg { width: min(100%, 280px, calc(var(--sponsor-ratio) * 180px)); }
  }
</style>
