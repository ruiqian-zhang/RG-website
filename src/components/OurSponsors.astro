---
import SponsorLogos from './SponsorLogos.astro';
const { partners, id = 'supporters' } = Astro.props;
const headingId = `${id}-title`;
---
<section class="partners section-shell" id={id} aria-labelledby={headingId}>
  <h2 id={headingId}>Our sponsors</h2>
  <SponsorLogos partners={partners} />
</section>
<style>
  .partners { min-height: calc(100svh - var(--header-height)); display: flex; flex-direction: column; justify-content: center; padding: 80px clamp(24px, 8vw, 124px); background: var(--paper); color: var(--ink); scroll-snap-align: start; scroll-margin-top: var(--header-height); }
  h2 { margin: 0 0 40px; text-align: center; font: 700 clamp(36px, 4.5vw, 58px)/1.05 var(--display); letter-spacing: -.035em; text-wrap: balance; }
  @media (max-width: 540px) { .partners { padding: 56px 23px; } h2 { margin-bottom: 44px; } }
</style>
