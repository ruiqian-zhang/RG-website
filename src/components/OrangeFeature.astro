---
import { withBase } from '../lib/urls';
const { title, description, image, imageAlt, label, imagePosition = '62% center' } = Astro.props;
---
<section class="orange-feature">
  <div class="feature-photo"><img src={withBase(image)} alt={imageAlt} style={{ objectPosition: imagePosition }} loading="lazy" /></div>
  <div class="feature-copy">
    {label && <p class="feature-label">{label}</p>}
    <h1>{title}</h1>
    <p>{description}</p>
    <slot />
  </div>
</section>
<style>
  .orange-feature { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 0; background: var(--orange); color: var(--ink); }
  .feature-photo { position: relative; min-width: 0; min-height: 560px; overflow: hidden; }
  /* Mask only the corner; clipping the whole photo can leave fractional-pixel seams. */
  .feature-photo::after { position: absolute; top: 0; right: 0; width: 24px; height: 24px; content: ''; background: var(--orange); clip-path: polygon(0 0, 100% 0, 100% 100%); }
  .feature-photo img { position: absolute; inset: -1px; display: block; max-width: none; width: calc(100% + 2px); height: calc(100% + 2px); object-fit: cover; object-position: 62% center; }
  .feature-copy { display: flex; flex-direction: column; align-items: flex-start; justify-content: center; padding: 72px clamp(24px, 6vw, 100px); }
  h1 { margin: 0 0 24px; font: 700 clamp(44px, 5vw, 72px)/.98 var(--display); letter-spacing: -.04em; }
  p { max-width: 480px; margin: 0 0 28px; font-size: var(--font-body-min); line-height: 1.6; }
  .feature-label { margin-bottom: 20px; font-size: var(--font-label-min); font-weight: 700; letter-spacing: .1em; text-transform: uppercase; }
  @media (max-width: 680px) {
    .orange-feature { grid-template-columns: 1fr; }
    .feature-photo { min-height: 0; aspect-ratio: 16 / 9; }
    .feature-copy { padding: 32px 23px; }
  }
</style>
